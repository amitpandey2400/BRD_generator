# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Gmail API Configuration
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Slack API Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Fireflies API Configuration
FIREFLIES_API_KEY=your-fireflies-api-key

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/brd_generator
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Application Settings
APP_NAME=BRD Generator
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-this-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Celery Configuration (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Document Storage
DOCUMENT_STORAGE_PATH=./storage/documents
MAX_UPLOAD_SIZE=52428800  # 50MB

# AI Processing
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_TOKENS=4000
TEMPERATURE=0.7

# BRD Generation Settings
DEFAULT_BRD_TEMPLATE=standard
ENABLE_AUTO_CITATION=true
ENABLE_CONFLICT_DETECTION=true
ENABLE_SENTIMENT_ANALYSIS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
